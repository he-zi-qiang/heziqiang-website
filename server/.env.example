# —— 后端环境变量 —— 复制为 .env 后按需修改

# SQLite 数据库文件（相对于 server/prisma/）
DATABASE_URL="file:../data/site.db"

# 监听地址与端口（用 SERVER_PORT，避免和前端工具链的 PORT 撞车）
SERVER_PORT=3001
HOST=127.0.0.1

# 会话签名密钥 —— 生产环境务必换成随机值：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-secret-please-change-me-in-production"
COOKIE_SECRET="dev-only-cookie-secret-change-me-too"

# 允许跨域的前端地址（开发时 Vite 的地址；生产同源可留空）
CORS_ORIGIN="http://localhost:5173"

# 首次 seed 时创建的管理员账号。
# 这份文件是进版本库的，别把真实用户名和密码写在这里——
# 复制成 .env 之后再改，.env 已被 .gitignore 排除。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-after-first-login"
ADMIN_DISPLAY_NAME="站长"

# 上传目录（相对于 server/）
UPLOAD_DIR="uploads"
